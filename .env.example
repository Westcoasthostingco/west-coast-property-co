# Copy to .env.local. Never commit real values.

# Clerk (roles are set per user in publicMetadata: {"role":"admin"|"owner"|"cleaner"})
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=       # Clerk dashboard -> Webhooks -> endpoint /api/webhooks/clerk (user.created)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # pooled connection string

# Stripe (Connect enabled)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=              # from the dashboard webhook endpoint for /api/webhooks/stripe
CRON_SECRET=                        # any long random string; Vercel sends it to /api/cron/payouts
NEXT_PUBLIC_APP_URL=                # https://westcoasthostingco.com (used for Stripe redirect URLs)

# Email
RESEND_API_KEY=

# SMS and door codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SEAM_API_KEY=

# Maps and spam protection
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Accounting (QuickBooks Online)
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=
