# Copy to .env.local. Never commit real values.

# Clerk (roles are set per user in publicMetadata: {"role":"admin"|"owner"|"cleaner"})
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
CLERK_WEBHOOK_SIGNING_SECRET=       # Clerk dashboard -> Webhooks -> endpoint /api/webhooks/clerk (user.created)

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only
DATABASE_URL=                       # pooled connection string

# Stripe (Connect enabled)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=              # from the dashboard webhook endpoint for /api/webhooks/stripe
CRON_SECRET=                        # REQUIRED in every Vercel environment. Any long random string; Vercel sends it as a bearer token to /api/cron/daily (payouts, iCal sync, hold sweep) and the admin "Run payouts now" button checks it
NEXT_PUBLIC_APP_URL=                # https://westcoasthostingco.com (used for Stripe redirect URLs)

# Email
RESEND_API_KEY=
EMAIL_FROM="West Coast Hosting Co <hello@westcoasthostingco.com>"
CONTACT_TO=hello@westcoasthostingco.com

# SMS and door codes
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SEAM_API_KEY=

# Maps and spam protection
NEXT_PUBLIC_MAPBOX_TOKEN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Accounting (QuickBooks Online)
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Monitoring
SENTRY_DSN=

# Live conditions widgets (tides from NOAA CO-OPS, snow from Open-Meteo) need no API keys.
# The station and resort are set per home in the admin property form. Set to 1 to force sample data (previews, offline dev).
CONDITIONS_SAMPLE=

# Preview only: show the portals without Clerk on Vercel Preview deployments.
# Ignored when VERCEL_ENV=production. Values: admin | owner | cleaner
PREVIEW_ROLE=
